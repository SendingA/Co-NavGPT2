# Copy this file to the repository root as .env before using Docker Compose.
# Do not commit .env or put an OpenAI key in this example.

FIRENAV_IMAGE=firenav:latest
FIRENAV_HOST_UID=1000
FIRENAV_HOST_GID=1000

# Licensed/generated assets remain on the host and are bind-mounted.
FIRENAV_DATA_DIR=./data
FIRENAV_OUTPUT_DIR=./outputs/docker
FIRENAV_MOBILE_SAM_PATH=./mobile_sam.pt
FIRENAV_YOLO_WORLD_PATH=./yolov8l-world.pt

# GPU selection. Use all, 0, or a comma-separated list accepted by the NVIDIA
# Container Toolkit.
FIRENAV_NVIDIA_VISIBLE_DEVICES=all

# Set only in the untracked root .env when nav_mode=gpt is required.
OPENAI_API_KEY=
