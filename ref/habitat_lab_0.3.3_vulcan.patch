+    rotation: Sequence[float], yaw_offset: float
+) -> List[float]:
+    """Apply a world-space yaw offset to an ``[x, y, z, w]`` quaternion."""
+    base_rotation = quaternion_from_coeff([float(value) for value in rotation])
